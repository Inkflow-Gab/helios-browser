<?xml version="1.0" encoding="utf-8"?>
<!--
    Helios launcher background.

    The ray disc itself lives in the foreground because that is the layer the launcher animates.
    Here we only supply the OLED-black plate plus a static orbit ring, which reads as a horizon
    line behind the mark and stops the icon from looking like a floating sticker.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="66"
                android:startColor="#141B2E"
                android:centerColor="#0A0E18"
                android:endColor="#000000" />
        </aapt:attr>
    </path>

    <!-- Orbit ring. Kept out of the foreground so the rotation only moves the rays. -->
    <path
        android:pathData="M54,30 A24,24 0 1,1 53.99,30 Z"
        android:strokeColor="#2E3A55"
        android:strokeWidth="1.5"
        android:fillColor="#00000000" />

    <path
        android:pathData="M54,38 A16,16 0 1,1 53.99,38 Z"
        android:strokeColor="#223050"
        android:strokeWidth="1"
        android:fillColor="#00000000" />
</vector>
