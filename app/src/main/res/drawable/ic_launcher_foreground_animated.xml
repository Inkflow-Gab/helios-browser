<?xml version="1.0" encoding="utf-8"?>
<!--
    Animated variant of ic_launcher_foreground: the rays rotate once every 14 seconds.

    A top-level <animated-rotate> applies to the whole drawable, which is why the static orbit
    rings live in ic_launcher_background instead - rotating them would be invisible but pointless,
    and keeping them out means the only moving part is the mark itself.

    Support: AnimatedVectorDrawable as an adaptive-icon foreground works from API 26, but only
    launchers that actually animate their icons (Pixel, AOSP, recent One UI) will show the motion.
    Everything else falls back to the still frame. minSdk is 26, so nothing degrades below that.
-->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group android:name="halo">
        <path
            android:pathData="M54,42 A12,12 0 1,1 53.99,42 Z"
            android:fillColor="#33FFC94D" />
    </group>

    <group android:name="rays" android:pivotX="54" android:pivotY="54">
        <group android:pivotX="54" android:pivotY="54" android:rotation="0">
            <path android:pathData="M51.6,42 L56.4,42 L55.2,29 L52.8,29 Z" android:fillColor="#FFD166" />
        </group>
        <group android:pivotX="54" android:pivotY="54" android:rotation="45">
            <path android:pathData="M52.2,42 L55.8,42 L55,32 L53,32 Z" android:fillColor="#FFC94D" />
        </group>
        <group android:pivotX="54" android:pivotY="54" android:rotation="90">
            <path android:pathData="M51.6,42 L56.4,42 L55.2,29 L52.8,29 Z" android:fillColor="#FFD166" />
        </group>
        <group android:pivotX="54" android:pivotY="54" android:rotation="135">
            <path android:pathData="M52.2,42 L55.8,42 L55,32 L53,32 Z" android:fillColor="#FFC94D" />
        </group>
        <group android:pivotX="54" android:pivotY="54" android:rotation="180">
            <path android:pathData="M51.6,42 L56.4,42 L55.2,29 L52.8,29 Z" android:fillColor="#FFD166" />
        </group>
        <group android:pivotX="54" android:pivotY="54" android:rotation="225">
            <path android:pathData="M52.2,42 L55.8,42 L55,32 L53,32 Z" android:fillColor="#FFC94D" />
        </group>
        <group android:pivotX="54" android:pivotY="54" android:rotation="270">
            <path android:pathData="M51.6,42 L56.4,42 L55.2,29 L52.8,29 Z" android:fillColor="#FFD166" />
        </group>
        <group android:pivotX="54" android:pivotY="54" android:rotation="315">
            <path android:pathData="M52.2,42 L55.8,42 L55,32 L53,32 Z" android:fillColor="#FFC94D" />
        </group>
    </group>

    <group android:name="core">
        <path
            android:pathData="M54,43 A11,11 0 1,1 53.99,43 Z"
            android:fillColor="#FFC94D" />
        <path
            android:pathData="M54,47 A7,7 0 1,1 53.99,47 Z"
            android:fillColor="#FFF3D6" />
    </group>

    <animated-rotate
        android:name="spin"
        android:duration="14000"
        android:fromDegrees="0"
        android:toDegrees="360"
        android:pivotX="54"
        android:pivotY="54"
        android:repeatCount="infinite" />
</animated-vector>