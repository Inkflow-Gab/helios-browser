<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 13+ adds the monochrome layer, which lets the themed-icon feature tint the mark with
    the user's wallpaper palette. It is deliberately kept out of mipmap-anydpi-v26: <monochrome>
    is ignored by older launchers but AAPT flags it as an unknown child element on API 26-32.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground_animated" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>